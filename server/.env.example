PORT=4000

# Allowed CORS origin for the React client (Vite default)
CORS_ORIGIN=http://localhost:5173

# Access from another device on the same Wi-Fi:
# Set this to the client URL using your PC's IPv4 address (from `ipconfig`), then restart the server.
CORS_ORIGIN=http://192.168.68.118:5173

# MongoDB Atlas (recommended)
# Replace USER, PASS, and CLUSTER with values from Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/choreolab?retryWrites=true&w=majority

# Local MongoDB (optional)
# MONGODB_URI=mongodb://localhost:27017/choreolab
