PORT=4000

# Allowed CORS origin for the React client (Vite default)
# CORS_ORIGIN=http://localhost:5173

# Client URL for password reset links
CLIENT_URL=http://localhost:5173

# Required for JWT auth (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Resend — password reset emails (https://resend.com)
# 1. Create account → API Keys → create key → paste below
# 2. Without a verified domain, use onboarding@resend.dev and Resend only
#    delivers to the email address you signed up with (fine for testing)
# 3. For production: Domains → add/verify your domain, then set EMAIL_FROM
RESEND_API_KEY=
EMAIL_FROM=ChoreoLab <onboarding@resend.dev>

# MongoDB Atlas (recommended)
# Replace USER, PASS, and CLUSTER with values from Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/choreolab?retryWrites=true&w=majority

# Local MongoDB (optional)
# MONGODB_URI=mongodb://localhost:27017/choreolab
