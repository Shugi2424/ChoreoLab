# Local development (same machine)
VITE_GRAPHQL_URL=http://localhost:4000/graphql

# Production (Vercel): set in Project → Settings → Environment Variables
# VITE_GRAPHQL_URL=https://your-render-service.onrender.com/graphql

# Access from phone/tablet on the same Wi-Fi (local dev only):
# 1. Run `ipconfig` on this PC and note the Wi-Fi IPv4 address (e.g. 192.168.1.42)
# 2. Set VITE_GRAPHQL_URL=http://<your-ip>:4000/graphql and matching CORS_ORIGIN on the server
# 3. Open the Network URL Vite prints (e.g. http://192.168.1.42:5173) on the other device
