# Local development (same machine)
VITE_GRAPHQL_URL=http://localhost:4000/graphql

# Access from phone/tablet on the same Wi-Fi:
# 1. Run `ipconfig` on this PC and note the Wi-Fi IPv4 address (e.g. 192.168.1.42)
# 2. Uncomment and replace the IP below, then restart `npm run dev`
# 3. Open the Network URL Vite prints (e.g. http://192.168.1.42:5173) on the other device
VITE_GRAPHQL_URL=http://192.168.88.118:4000/graphql
